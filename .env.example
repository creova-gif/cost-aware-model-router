# Provider API Keys (replace with your own credentials in local .env; never commit real secrets)
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Control-Plane Server Configuration
COST_ROUTER_HOST=127.0.0.1
COST_ROUTER_PORT=8080
COST_ROUTER_DB_PATH=/data/economics.db
COST_ROUTER_AUTH_CONFIG=./keys.json
